{
    "name": "@typelens/web",
    "private": true,
    "version": "1.1.0",
    "type": "module",
    "description": "TypeLens - local-first typing analytics dashboard for Monkeytype sessions.",
    "scripts": {
        "dev": "vite",
        "dev:silent": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "tsc --noEmit",
        "db:push": "echo 'TypeLens has no database; skipping db:push'",
        "db:generate": "echo 'TypeLens has no database; skipping db:generate'",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@typelens/core": "*",
        "@typelens/host-contract": "*",
        "chart.js": "4.6.1",
        "date-fns": "4.4.0",
        "hack-font": "^3.3.0",
        "lucide-react": "1.64.0",
        "react": "19.3.1",
        "react-chartjs-2": "5.3.1",
        "react-dom": "19.3.1",
        "react-router-dom": "6.28.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "^10.6.2",
        "postcss": "^8.5.32",
        "tailwindcss": "3.4.14",
        "typescript": "5.6.3",
        "vite": "^8.3.5"
    }
}
